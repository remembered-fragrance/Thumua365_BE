// Schema database THUMUA365 — đủ bốn nhóm bảng của kiến trúc v2 (KH backend §1.3).
//
// Prisma Migrate là nơi DUY NHẤT sửa schema. Những gì Prisma không diễn tả được
// (CHECK, index một phần, trigger, hàm, role, quyền, RLS) nằm trong phần SQL viết
// tay của file migration — xem đầu và cuối prisma/migrations/*/migration.sql.
//
// Quy ước (giữ từ supabase/migrations/0001 của repo frontend):
//   - Tên cột snake_case trong DB, camelCase trong code (@map). Đổi tên ở lớp dữ liệu.
//   - Bảng SỔ (ghi offline): id do CLIENT sinh, không có default.
//     Bảng còn lại: id do server sinh (gen_random_uuid()).
//   - Xoá mềm bằng deleted_at. Role api_service không có quyền DELETE.
//   - Tiền: BigInt (số nguyên đồng). Khối lượng, %, đơn giá: Float.
//   - updated_at do trigger touch_updated_at đặt, không do Prisma.
//   - Không khoá ngoại sang auth.users: database không phụ thuộc schema của
//     Supabase Auth. Việc cần Auth (email đăng nhập, phone_confirmed_at) đi qua
//     Auth API.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Tổ chức ─────────────────────────────────────────────────────────────────

/// Mọi chủ thể là một tổ chức, kể cả hộ nông dân một người.
model Organization {
  id        String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// farmer | trader | enterprise
  type      String
  name      String
  phone     String?
  address   String?
  location  Unsupported("geography(Point, 4326)")?
  createdBy String                                 @map("created_by") @db.Uuid
  createdAt DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                               @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?                              @map("deleted_at") @db.Timestamptz(6)

  memberships    Membership[]
  branches       Branch[]
  subscriptions  Subscription[]
  features       OrganizationFeature[]
  suppliers      Supplier[]
  buyers         Buyer[]
  products       Product[]
  transactions   Transaction[]
  payments       Payment[]
  drafts         Draft[]
  pricingRules   PricingRule[]
  notes          Note[]
  seasonContracts SeasonContract[]
  paymentIntents PaymentIntent[]
  notifications  Notification[]
  syncOps        SyncOp[]
  ownedLinks     PartnerLink[]         @relation("LinkOwner")
  linkedLinks    PartnerLink[]         @relation("LinkLinked")
  ordersSelling  Order[]               @relation("OrderSeller")
  ordersBuying   Order[]               @relation("OrderBuyer")
  ordersCreated  Order[]               @relation("OrderCreator")
  places         Place[]

  @@map("organizations")
}

model Branch {
  id             String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                                 @map("organization_id") @db.Uuid
  name           String
  address        String?
  location       Unsupported("geography(Point, 4326)")?
  createdAt      DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                               @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?                              @map("deleted_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id])
  memberships  Membership[]
  transactions Transaction[]
  drafts       Draft[]
  orders       Order[]

  /// Đích của khoá ngoại ghép: bản ghi chỉ trỏ được tới chi nhánh CÙNG tổ chức.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("branches")
}

/// Người dùng (auth.users.id) ở trong tổ chức nào, với vai trò gì.
model Membership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// owner | manager | staff
  role           String
  /// Nhân viên gắn với một chi nhánh; null = cả tổ chức.
  branchId       String?  @map("branch_id") @db.Uuid
  /// invited | active | removed
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId, organizationId], references: [id, organizationId])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Gói của một tổ chức vựa/doanh nghiệp. Nông dân không có hàng nào ở đây.
/// Không có trạng thái 'expired' — suy ra từ ngày tháng (@mambo/core/subscription).
model Subscription {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  /// trialing | active | past_due | canceled
  status             String
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(6)
  /// Doanh nghiệp: số chi nhánh tối đa theo gói. null = không giới hạn.
  branchLimit        Int?      @map("branch_limit")
  /// Đã cộng tháng thưởng giới thiệu (cho tổ chức này và người mời) — chỉ một lần.
  referralRewardedAt DateTime? @map("referral_rewarded_at") @db.Timestamptz(6)
  /// thuong_lai | vua — gói vựa đã chọn (0.28.0). Doanh nghiệp null.
  plan               String?
  /// Người cân mua thêm ngoài 3 người gói Vựa có sẵn (0–5).
  extraStaff         Int       @default(0) @map("extra_staff") @db.SmallInt
  /// Kỳ trả tiền gần nhất: 1 | 12 tháng — đơn giá ngày khi mua thêm người cân. null = coi là 1.
  billingMonths      Int?      @map("billing_months") @db.SmallInt
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  paymentIntents PaymentIntent[]

  @@index([organizationId])
  @@map("subscriptions")
}

/// Tính năng bật cho từng tổ chức — mở dần cho nhóm pilot (KH §3.3).
model OrganizationFeature {
  organizationId String   @map("organization_id") @db.Uuid
  feature        String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, feature])
  @@map("organization_features")
}

/// Phần THUMUA365 cần thêm cho một tài khoản Supabase Auth. id = auth.users.id.
model Profile {
  id            String    @id @db.Uuid
  name          String
  /// Gõ "VuaBaTam" hay "vuabatam" đều vào một tài khoản.
  username      String?   @unique @db.Citext
  /// Luôn ở dạng +84… (CHECK normalize_phone). Là khoá đăng nhập.
  phone         String?   @unique
  /// Email thật người dùng khai thêm — chỉ để tự lấy lại mật khẩu.
  recoveryEmail String?   @map("recovery_email") @db.Citext
  /// Lúc chủ hộp thư bấm link xác nhận. Chỉ email đã xác nhận mới nhận thư đặt lại mật khẩu.
  /// Đổi email → trigger đưa về NULL (cùng mã đang chờ).
  recoveryEmailVerifiedAt     DateTime? @map("recovery_email_verified_at") @db.Timestamptz(6)
  /// sha256 (hex) của mã trong thư xác nhận — không lưu mã gốc.
  recoveryEmailTokenHash      String?   @map("recovery_email_token_hash")
  recoveryEmailTokenExpiresAt DateTime? @map("recovery_email_token_expires_at") @db.Timestamptz(6)
  /// Lần gần nhất API gửi thư cho người này (xác nhận / đặt lại mật khẩu) — chặn gửi dồn.
  authMailSentAt              DateTime? @map("auth_mail_sent_at") @db.Timestamptz(6)
  /// Do trigger sinh, không nhận từ client.
  referralCode  String?   @unique @map("referral_code") @db.Citext
  referredBy    String?   @map("referred_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([referredBy])
  @@map("profiles")
}

// ─── Chuỗi — dùng chung giữa hai tổ chức, id do server sinh ──────────────────

/// Dòng danh bạ trong sổ của `owner` ↔ tổ chức có tài khoản thật (`linked`).
/// Chỉ `active` khi CHÍNH bên được liên kết nhập đúng mã kết nối (claim_link), hoặc đồng ý
/// với số điện thoại đã xác thực OTP trùng số được mời (OTP tạm ẩn).
model PartnerLink {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerOrgId          String    @map("owner_org_id") @db.Uuid
  /// supplier | buyer — partner_id trỏ vào bảng tương ứng trong sổ của owner.
  partnerKind         String    @map("partner_kind")
  partnerId           String    @map("partner_id") @db.Uuid
  linkedOrgId         String?   @map("linked_org_id") @db.Uuid
  invitedPhone        String?   @map("invited_phone")
  /// Mã kết nối 8 ký tự bên owner đưa tận tay. Chỉ sống khi `pending` (trigger xoá khi đổi trạng thái).
  inviteCode          String?   @unique @map("invite_code")
  inviteCodeExpiresAt DateTime? @map("invite_code_expires_at") @db.Timestamptz(6)
  /// pending | active | revoked
  status              String    @default("pending")
  decidedBy           String?   @map("decided_by") @db.Uuid
  decidedAt           DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner  Organization  @relation("LinkOwner", fields: [ownerOrgId], references: [id])
  linked Organization? @relation("LinkLinked", fields: [linkedOrgId], references: [id])

  @@index([ownerOrgId])
  @@index([linkedOrgId])
  @@map("partner_links")
}

/// Ý định mua/bán giữa hai tổ chức, TRƯỚC khi cân. Server giữ, không nằm trong sổ offline.
model Order {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerOrgId     String?   @map("seller_org_id") @db.Uuid
  sellerPartnerId String?   @map("seller_partner_id") @db.Uuid
  /// null: bên đó đã xoá tài khoản (cùng seller_org_id, created_by_org_id) — đơn còn trong sổ bên kia.
  buyerOrgId      String?   @map("buyer_org_id") @db.Uuid
  buyerPartnerId  String?   @map("buyer_partner_id") @db.Uuid
  createdByOrgId  String?   @map("created_by_org_id") @db.Uuid
  createdBy       String    @map("created_by") @db.Uuid
  productId       String?   @map("product_id") @db.Uuid
  crop            String?
  estQuantity     Float     @map("est_quantity")
  unit            String    @default("kg")
  offeredPrice    Float?    @map("offered_price")
  /// submitted | accepted | scheduled | fulfilled | cancelled
  status          String    @default("submitted")
  pickupAt        DateTime? @map("pickup_at") @db.Timestamptz(6)
  pickupAddress   String?   @map("pickup_address")
  branchId        String?   @map("branch_id") @db.Uuid
  /// Tăng mỗi lần chuyển trạng thái; lệch → 409 ORDER_STATE_CHANGED.
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  seller       Organization? @relation("OrderSeller", fields: [sellerOrgId], references: [id])
  buyer        Organization? @relation("OrderBuyer", fields: [buyerOrgId], references: [id])
  creatorOrg   Organization? @relation("OrderCreator", fields: [createdByOrgId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  events       OrderEvent[]
  transactions Transaction[]
  drafts       Draft[]

  @@index([sellerOrgId, status])
  @@index([buyerOrgId, status])
  @@map("orders")
}

/// Mọi lần đơn đổi trạng thái. Chỉ ghi thêm.
model OrderEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Tổ chức làm bước này (BE5) — lịch sử đơn nói "mình" hay "bên kia".
  actorOrgId  String?  @map("actor_org_id") @db.Uuid
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ─── Bản đồ — mọi người đã đăng nhập đều đọc, id do server sinh ──────────────

/// Địa điểm thu mua của vựa / doanh nghiệp trên bản đồ. Vị trí của người dùng KHÔNG lưu ở đâu cả.
model Place {
  id              String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                                 @map("organization_id") @db.Uuid
  createdBy       String                                 @map("created_by") @db.Uuid
  /// trader | enterprise — đặt theo loại tổ chức lúc tạo, client không gửi.
  kind            String
  name            String
  address         String?
  phone           String?
  description     String?
  lat             Float
  lng             Float
  /// Cột GENERATED ALWAYS từ (lng, lat) — chỉ để truy vấn không gian (index GiST). Không ghi từ
  /// Prisma. `dbgenerated` chép đúng biểu thức Postgres đọc lại, để `migrate diff` không báo lệch.
  location        Unsupported("geography(Point, 4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(lng, lat), 4326))::geography"))
  /// V9 — [{ product, price, unit }], tối đa 10. NULL = chưa khai giá.
  prices          Json?
  pricesUpdatedAt DateTime?                              @map("prices_updated_at") @db.Timestamptz(6)
  createdAt       DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                               @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                              @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("places")
}

// ─── Sổ — ghi offline, id do CLIENT sinh ─────────────────────────────────────

model Supplier {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  name           String
  /// Như vựa gõ. So khớp kết nối qua normalize_phone(phone).
  phone          String?
  location       String?
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, updatedAt])
  @@map("suppliers")
}

model Buyer {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  name           String
  phone          String?
  location       String?
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, updatedAt])
  @@map("buyers")
}

model Product {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  createdBy        String    @map("created_by") @db.Uuid
  name             String
  unit             String    @default("kg")
  /// standard | netAfterTare | rubberLatex | lossPercent
  formulaType      String    @map("formula_type")
  isSuggested      Boolean   @default(false) @map("is_suggested")
  isActive         Boolean   @default(true) @map("is_active")
  /// rubber | cashew | coffee | pepper
  crop             String?
  lastPricePerUnit Float?    @map("last_price_per_unit")
  group            String?
  qualityGrades    String[]  @map("quality_grades")
  trackInventory   Boolean?  @map("track_inventory")
  /// latex | cuplump — V20, NULL = mủ nước
  rubberKind       String?   @map("rubber_kind")
  /// V24 — kg cà phê tươi ra 1 kg nhân (> 1, ≤ 20). NULL = không quy đổi.
  greenRatio       Float?    @map("green_ratio")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, updatedAt])
  @@map("products")
}

/// Phiếu mua/bán đã chốt. KHÔNG có cột amount_paid — luôn sum(payments).
model Transaction {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  /// Phiếu lập theo đơn — đồng bộ lên thì đơn tự sang fulfilled (BE5).
  orderId        String?   @map("order_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  date           DateTime  @db.Timestamptz(6)
  /// purchase | sale
  kind           String
  /// suppliers.id khi mua, buyers.id khi bán. NULL = Khách lẻ.
  counterpartyId String?   @map("counterparty_id") @db.Uuid
  /// Giữ vì core/types.ts Transaction.supplierId còn bắt buộc.
  supplierId     String?   @map("supplier_id")
  supplierName   String    @map("supplier_name")
  /// Đóng băng theo phiếu (freezeLineTotals) — JSONB, camelCase bên trong.
  lines          Json
  creditTerms    Json?     @map("credit_terms")
  adjustments    Json?
  attachmentIds  String[]  @map("attachment_ids")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId, organizationId], references: [id, organizationId])
  order        Order?       @relation(fields: [orderId], references: [id])
  payments     Payment[]

  /// Đích của khoá ngoại ghép từ payments: lần trả chỉ gắn được vào phiếu CÙNG tổ chức.
  @@unique([id, organizationId])
  @@index([organizationId, date(sort: Desc)])
  @@index([organizationId, updatedAt])
  @@index([organizationId, counterpartyId])
  @@map("transactions")
}

/// Lần trả tiền — CHỈ GHI THÊM. Huỷ = xoá mềm; không bao giờ sửa số tiền.
model Payment {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  transactionId  String    @map("transaction_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  date           DateTime  @db.Timestamptz(6)
  amount         BigInt
  note           String?
  /// cash | transfer. null = app cũ / không ghi (Đợt 2, V13).
  method         String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Có từ BE2: huỷ một lần trả phải lan sang máy khác khi kéo theo updated_at.
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  /// Khoá ngoại GHÉP (phiếu, tổ chức): khoá ngoại được kiểm không qua RLS, nên khoá một cột
  /// để tổ chức A gắn lần trả vào phiếu của tổ chức B (BE3 — đã thử được trên Postgres).
  transaction  Transaction  @relation(fields: [transactionId, organizationId], references: [id, organizationId])

  @@index([transactionId])
  @@index([organizationId, updatedAt])
  @@map("payments")
}

model Draft {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  orderId        String?   @map("order_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  /// draft | waiting
  status         String    @default("draft")
  /// purchase | sale
  kind           String?
  counterpartyId String?   @map("counterparty_id") @db.Uuid
  supplierId     String?   @map("supplier_id")
  supplierName   String    @default("") @map("supplier_name")
  lines          Json      @default("[]")
  amountPaid     BigInt    @default(0) @map("amount_paid")
  /// Khoản cộng/trừ đang nhập — như transactions.adjustments. NULL = chưa có khoản nào.
  adjustments    Json?
  note           String?
  attachmentIds  String[]  @map("attachment_ids")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId, organizationId], references: [id, organizationId])
  order        Order?       @relation(fields: [orderId], references: [id])

  @@index([organizationId, updatedAt])
  @@map("drafts")
}

model PricingRule {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  createdBy       String    @map("created_by") @db.Uuid
  name            String
  /// logistics | volumeDiscount | manual
  kind            String
  productId       String?   @map("product_id") @db.Uuid
  fixedAmount     BigInt?   @map("fixed_amount")
  percentOfTotal  Float?    @map("percent_of_total")
  minWeightKg     Float?    @map("min_weight_kg")
  appliesOnPickup Boolean?  @map("applies_on_pickup")
  active          Boolean   @default(true)
  /// bulkDensity | moisturePercent | impurityPercent | kor | qualityPercent — V19
  qualityMetric   String?   @map("quality_metric")
  /// [{ from, amountPerUnit }]
  qualitySteps    Json?     @map("quality_steps")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, updatedAt])
  @@map("pricing_rules")
}

model Note {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  body           String
  pinned         Boolean   @default(false)
  done           Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, updatedAt])
  @@map("notes")
}

/// V15 — hợp đồng mùa vụ: giữ giá / số lượng với một người bán hoặc người mua. Đã giao app tự cộng từ phiếu.
model SeasonContract {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  createdBy        String    @map("created_by") @db.Uuid
  /// purchase | sale
  kind             String
  counterpartyId   String?   @map("counterparty_id")
  counterpartyName String    @map("counterparty_name")
  productId        String?   @map("product_id")
  productName      String    @map("product_name")
  unit             String    @default("kg")
  quantity         Float
  pricePerUnit     Float?    @map("price_per_unit")
  startDate        DateTime  @map("start_date") @db.Timestamptz(6)
  endDate          DateTime  @map("end_date") @db.Timestamptz(6)
  note             String?
  closed           Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, updatedAt])
  @@map("season_contracts")
}

// ─── Hệ thống ────────────────────────────────────────────────────────────────

/// Chống trùng thao tác đồng bộ: ghi cùng transaction với thao tác (KH §4.1).
model SyncOp {
  opId           String   @id @map("op_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  seq            BigInt
  /// insert | update | softDelete
  kind           String
  entity         String
  recordId       String   @map("record_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("sync_ops")
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// null = cho mọi thành viên của tổ chức.
  userId         String?   @map("user_id") @db.Uuid
  kind           String
  payload        Json      @default("{}")
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Đo lường first-party. Không tên, SĐT, email hay số tiền cụ thể (R5).
model AnalyticsEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  orgType        String?  @map("org_type")
  anonId         String   @map("anon_id")
  name           String
  props          Json     @default("{}")
  appVersion     String?  @map("app_version")
  platform       String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([name, createdAt])
  @@map("analytics_events")
}

/// Góp ý + chấm sao trong app (0.25.0). api_service chỉ ghi thêm; quản trị đọc ở Supabase.
/// Không khoá ngoại, như analytics_events; xoá tài khoản thì xoá theo `user_id`.
model Feedback {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  rating         Int
  comment        String?
  appVersion     String?  @map("app_version")
  platform       String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("feedback")
}

/// Thao tác nhạy cảm: xoá phiếu, huỷ lần trả, đổi quyền, kết nối... CHỈ GHI THÊM.
/// Không khoá ngoại: xoá tổ chức không được xoá dấu vết.
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_log")
}

/// Chống trùng webhook: khoá chính CHÍNH LÀ mã giao dịch ngân hàng. Chỉ api_privileged.
model BankTransaction {
  bankTxId        String   @id @map("bank_tx_id")
  organizationId  String?  @map("organization_id") @db.Uuid
  paymentIntentId String?  @map("payment_intent_id") @db.Uuid
  amount          BigInt
  description     String?
  /// webhook | admin
  source          String   @default("webhook")
  /// applied | intent_closed | underpaid | no_intent — chỉ `applied` là đã gia hạn gói
  outcome         String   @default("applied")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("bank_transactions")
}

model PaymentIntent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  subscriptionId String?   @map("subscription_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  amount         BigInt
  /// pending | paid | failed | expired
  status         String
  provider       String
  /// Mã 6 ký tự trong nội dung chuyển khoản.
  providerRef    String?   @map("provider_ref")
  /// plan | staff (0.28.0) — mua / gia hạn gói, hay mua thêm người cân giữa kỳ.
  kind           String    @default("plan")
  /// thuong_lai | vua; null với staff và với ý định trước 0.28.0 (→ bảng giá cũ, gói Vựa).
  plan           String?
  /// 1 | 12; null với staff và với ý định trước 0.28.0.
  months         Int?      @db.SmallInt
  /// plan: người cân thêm trong kỳ mua; staff: số người mua thêm.
  extraStaff     Int       @default(0) @map("extra_staff") @db.SmallInt
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("payment_intents")
}

/// Quản trị viên chạm dữ liệu người dùng — bắt buộc người duyệt. Chỉ api_privileged.
model AdminAccessLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  /// Ai duyệt — nhập tay, không tự sinh.
  operator       String
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("admin_access_log")
}
