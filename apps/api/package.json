{
  "name": "@mambo/api",
  "version": "0.2.0",
  "private": true,
  "description": "NestJS API của THUMUA365",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "test:db": "prisma generate && vitest run --config vitest.db.config.ts",
    "db:up": "node scripts/db-local.mjs up",
    "db:down": "node scripts/db-local.mjs down",
    "db:reset": "node scripts/db-local.mjs reset",
    "db:migrate:local": "node scripts/db-local.mjs migrate",
    "db:role-password": "node scripts/db-role-password.mjs"
  },
  "dependencies": {
    "@mambo/contracts": "0.2.0",
    "@mambo/core": "0.2.0",
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "^10.75.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "nest-winston": "^2.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.5",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "unplugin-swc": "^1.6.0"
  }
}
