{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,
    "isolatedModules": false
  },
  "include": ["src"]
}
