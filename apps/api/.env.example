# Chép thành .env (đã .gitignore) rồi điền. KHÔNG commit giá trị thật.

APP_ENV=development
PORT=3000

# Project Supabase staging — URL và publishable key đều công khai (nằm sẵn trong app web).
SUPABASE_URL=https://bldlrkmszjmhifubxjvl.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# ── Bí mật từ BE2 — chỉ nằm ở file này và biến môi trường Render. KHÔNG dán qua chat. ──

# Khoá secret (sb_secret_…): Project Settings → API Keys. Chỉ cho Auth Admin API.
SUPABASE_SECRET_KEY=

# Migration (Prisma CLI) — role postgres. Supabase → Connect → ORM → Prisma → dòng DIRECT_URL
# (Session pooler, cổng 5432). Mật khẩu có ký tự đặc biệt thì mã hoá URL (@ → %40).
DIRECT_URL=

# API — role api_service (KHÔNG bypass RLS), Transaction pooler cổng 6543.
# Đừng điền tay: sau migration đầu tiên chạy `npm run db:role-password -w @mambo/api`,
# script đặt mật khẩu cho role và ghi dòng này.
DATABASE_URL=

# ── Bí mật từ BE6 — webhook ngân hàng, quản trị, xoá tài khoản. ──
# Role api_privileged (BYPASSRLS). Đặt mật khẩu như api_service (db:role-password), dùng user
# api_privileged.<ref> qua Transaction pooler. Máy dev (docker-compose): mật khẩu api_privileged_dev.
PRIVILEGED_DATABASE_URL=
# Bí mật dùng chung với Casso / SePay (≥ 24 ký tự ngẫu nhiên).
BANK_WEBHOOK_SECRET=
# Id tài khoản quản trị viên, cách nhau bằng dấu phẩy.
ADMIN_USER_IDS=

# Domain web được gọi API, cách nhau bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# Tuỳ chọn — để trống thì không gửi lỗi lên Sentry.
SENTRY_DSN=

# Header mang IP thật của người gọi, do proxy phía trước ghi đè. Máy dev: để trống.
# Render (sau Cloudflare): cf-connecting-ip — đã khai báo trong render.yaml.
CLIENT_IP_HEADER=
