# Chép thành .env (đã .gitignore) rồi điền. KHÔNG commit giá trị thật.

APP_ENV=development
PORT=3000

# Project Supabase staging — URL và publishable key đều công khai (nằm sẵn trong app web).
SUPABASE_URL=https://bldlrkmszjmhifubxjvl.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Domain web được gọi API, cách nhau bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# Tuỳ chọn — để trống thì không gửi lỗi lên Sentry.
SENTRY_DSN=

# Header mang IP thật của người gọi, do proxy phía trước ghi đè. Máy dev: để trống.
# Render (sau Cloudflare): cf-connecting-ip — đã khai báo trong render.yaml.
CLIENT_IP_HEADER=
