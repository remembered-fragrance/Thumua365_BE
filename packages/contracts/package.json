{
  "name": "@mambo/contracts",
  "version": "0.2.0",
  "description": "Hợp đồng API THUMUA365 — schema zod dùng chung cho NestJS và frontend",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "openapi.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "tsx scripts/openapi.ts"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "zod": "^4.1.0",
    "@mambo/core": "0.2.0"
  }
}
