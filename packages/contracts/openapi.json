{
  "openapi": "3.1.0",
  "info": {
    "title": "THUMUA365 API",
    "version": "0.3.0"
  },
  "servers": [
    {
      "url": "https://api.thumua365.vn",
      "description": "production"
    },
    {
      "url": "https://api-staging.thumua365.vn",
      "description": "staging"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "Trạng thái API",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    },
                    "version": {
                      "type": "string"
                    },
                    "commit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "env": {
                      "type": "string",
                      "enum": [
                        "development",
                        "staging",
                        "production"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "commit",
                    "env"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Lỗi — xem `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi — xem `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me",
        "summary": "Người đang đăng nhập, các tổ chức và quyền trong từng tổ chức",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "name": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "phone": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "email": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "phoneVerified": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "phone",
                        "email",
                        "phoneVerified"
                      ],
                      "additionalProperties": false
                    },
                    "memberships": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "organization": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                              },
                              "type": {
                                "type": "string",
                                "enum": [
                                  "farmer",
                                  "trader",
                                  "enterprise"
                                ]
                              },
                              "name": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "type",
                              "name"
                            ],
                            "additionalProperties": false
                          },
                          "role": {
                            "type": "string",
                            "enum": [
                              "owner",
                              "manager",
                              "staff"
                            ]
                          },
                          "branch": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "format": "uuid",
                                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                  },
                                  "name": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "id",
                                  "name"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "permissions": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "order:create",
                                "order:respond",
                                "book:sync",
                                "receipt:create",
                                "receipt:delete",
                                "payment:record",
                                "payment:void",
                                "partner:manage",
                                "pricing:manage",
                                "linked:read",
                                "staff:manage",
                                "branch:manage",
                                "report:view",
                                "billing:manage",
                                "account:delete"
                              ]
                            }
                          },
                          "plan": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "tier": {
                                    "type": "string",
                                    "enum": [
                                      "trial",
                                      "premium",
                                      "grace",
                                      "free"
                                    ]
                                  },
                                  "status": {
                                    "type": "string",
                                    "enum": [
                                      "trialing",
                                      "active",
                                      "past_due",
                                      "canceled"
                                    ]
                                  },
                                  "periodEnd": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "format": "date-time",
                                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "branchLimit": {
                                    "anyOf": [
                                      {
                                        "type": "integer",
                                        "exclusiveMinimum": 0,
                                        "maximum": 9007199254740991
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "tier",
                                  "status",
                                  "periodEnd",
                                  "branchLimit"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "features": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "orders",
                                "links"
                              ]
                            }
                          }
                        },
                        "required": [
                          "organization",
                          "role",
                          "branch",
                          "permissions",
                          "plan",
                          "features"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "pendingLinks": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "user",
                    "memberships",
                    "pendingLinks"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Lỗi — xem `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Lỗi — xem `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi — xem `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
