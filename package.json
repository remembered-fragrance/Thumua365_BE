{
  "name": "thumua365-be",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "npm run build -w @mambo/core && npm run build -w @mambo/contracts && npm run build -w @mambo/sdk",
    "build": "npm run build:packages && npm run build -w @mambo/api",
    "dev": "npm run build:packages && npm run dev -w @mambo/api",
    "db:up": "npm run db:up -w @mambo/api",
    "db:reset": "npm run db:reset -w @mambo/api",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:db": "npm run test:db -w @mambo/api",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "openapi": "npm run openapi -w @mambo/contracts",
    "mock": "npx -y @stoplight/prism-cli@5 mock packages/contracts/openapi.json",
    "verify": "npm run lint && npm run build:packages && npm run typecheck && npm run boundaries && npm run test && npm run build -w @mambo/api",
    "smoke:me": "node scripts/smoke-me.mjs",
    "login-test": "node tools/login-test/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^17.0.1",
    "oxlint": "^1.69.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "tsx": "^4.23.15"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.2": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": false
  }
}
